# 公众号排版助手 by Yoru — example environment file.
# Copy to .env and fill in. Never commit the real .env.

# ---- App -------------------------------------------------------------------
NODE_ENV=production
PORT=3100

# Bind address. Loopback keeps the app reachable only through the Cloudflare
# Tunnel; the host's public IP on this port must not serve the site directly.
HOST=127.0.0.1

# SQLite file. Relative paths resolve against the process working directory.
DATABASE_URL=file:./data/mopai.db

# Owner key. Typesetting, copying, exporting and uploading images all work
# without it; logging in is what unlocks the cloud drafts box.
# Generate with: openssl rand -hex 24
ACCESS_KEY=change-me

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me

# ---- Open uploads ----------------------------------------------------------
# Uploads need no login, so these four bound what a stranger can spend. All are
# optional; the defaults below are what the public instance runs with.
#
# Per visitor — a first-party cookie identifies the browser — over a rolling 24 h:
ANON_DAILY_IMAGES=30
ANON_DAILY_BYTES=104857600
# Every anonymous upload put together; the bucket is a shared free tier:
ANON_TOTAL_BYTES=1610612736
# Per source IP per minute, in memory, to stop a flood before it reaches disk:
ANON_BURST_PER_MINUTE=12
# Per source IP per UTC day, in memory. The visitor quota hangs on a cookie an
# attacker can delete; this is what makes rotating cookies expensive:
ANON_IP_DAILY_IMAGES=100

# ---- Image worker ----------------------------------------------------------
# Public base URL of the mopai-images worker.
IMG_BASE_URL=https://mopai-img.yoru-and-akari.dev

# Shared secret with the worker (wrangler secret put IMG_ADMIN_KEY).
# Generate with: openssl rand -hex 32
IMG_ADMIN_KEY=change-me

# ---- Agent API -------------------------------------------------------------
# Tokens for /api/agent/*, the door a coding agent uses to push a draft into the
# editor and read the polished article back. Comma-separated name:token pairs,
# with an optional scope suffix (:read for a token that may only read).
#
#   AGENT_TOKENS=claude-code:mopai_aaa…,reviewer:mopai_bbb…:read
#
# One token per agent, so deleting a line revokes that agent alone. The name is
# not secret — it is recorded as `agent:<name>` on every article it pushes.
# Mint one with:
#   python -c "import secrets,base64;print('mopai_'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
#
# Left empty (the default), every /api/agent/* request is refused with 401.
# This is NOT the browser's credential: ACCESS_KEY stays the human login.
#
# If the site sits behind Cloudflare Access, only /api/agent/* may be given a
# service-token bypass. Never /api/trpc/* — that prefix carries auth.login, and
# exposing it would open the access key to brute force from the internet.
AGENT_TOKENS=

# Absolute origin used to build the editorUrl handed back to agents. Optional:
# when unset it is derived from the incoming request, which is already the public
# origin behind a Cloudflare Tunnel. Set it only if something rewrites Host.
PUBLIC_BASE_URL=

# 公众号排版助手 by Yoru wechat-typesetter skill — example config.
# Copy to .env and fill in. The real .env is gitignored; never commit it.
#
# This file is the ONLY config source for scripts/mopai.py — the script does not
# read these keys from the environment, so the same token works no matter which
# shell, harness or cron job invokes it.

# ---- Connection -----------------------------------------------------------
# Base URL of the mopai deployment, no trailing slash. Overridable per command
# with --base-url.
MOPAI_API_URL=https://wechat.yoru-and-akari.dev

# ---- Credential -----------------------------------------------------------
# Agent token, format mopai_<base64url>. Sent as `Authorization: Bearer <token>`.
#
# Tokens are minted on the server, in the app's own .env:
#   AGENT_TOKENS=<name>:<token>          read+write
#   AGENT_TOKENS=<name>:<token>:read     read only
# Generate one with:
#   python -c "import secrets,base64;print('mopai_'+base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('='))"
#
# Write it here by hand, or let the script do it:
#   python scripts/mopai.py set-token mopai_xxx
# MOPAI_TOKEN=

# ---- Optional -------------------------------------------------------------
# Request timeout in seconds. Raise it for big images on a slow link.
# MOPAI_TIMEOUT=60

{
  "format": "reed-card-template",
  "formatVersion": 1,
  "id": "pine-notebook",
  "name": "Pine Notebook · 雾松笔记",
  "version": "1.0.0",
  "author": "Reed · 改编自 Haodong Cui/md2card（MIT）",
  "description": "改编自 Haodong Cui/md2card 的 notebook.css（MIT）。活页本：左侧一列打孔、浅松绿封面、标题写在纸页上；正文是横线本，行距与横线对齐，引用带绿色「摘录」标签；结尾简单署名落在横线上。",
  "ratios": ["3:4", "1:1", "9:16"],
  "defaultRatio": "3:4",
  "variants": [
    { "id": "pine", "name": "雾松", "dark": false, "tokens": { "accent": "#356C59", "text": "#18352A", "muted": "#506A5B" } },
    { "id": "dusk", "name": "松夜", "dark": true, "tokens": { "accent": "#8FC9AD", "text": "#E8F1EB", "muted": "#B6C9BD" } }
  ],
  "metrics": {
    "padX": 70,
    "padTop": 94,
    "padBottom": 70,
    "contentWidth": 400,
    "headerTop": 28,
    "footerBottom": 26,
    "coverInsetX": 46,
    "coverInsetY": 64,
    "coverFootBottom": 38,
    "coverReserve": 184,
    "coverTitleSize": [64, 58, 52, 46, 40],
    "coverSmallScale": 0.84
  },
  "fonts": [
    { "source": "builtin", "family": "Noto Serif SC", "weights": [400, 700] },
    { "source": "builtin", "family": "Noto Sans SC", "weights": [400, 700] },
    { "source": "builtin", "family": "Geist Mono", "weights": [400] }
  ],
  "customize": {
    "colors": [
      { "var": "--accent", "name": "主色" },
      { "var": "--title-ink", "name": "标题" },
      { "var": "--body-ink", "name": "正文" },
      { "var": "--muted", "name": "辅助文字" },
      { "var": "--paper", "name": "底色" }
    ],
    "fonts": [
      { "var": "--display", "name": "标题" },
      { "var": "--body-font", "name": "正文" }
    ]
  },
  "pages": { "cover": "pages/cover.html", "body": "pages/body.html", "end": "pages/end.html" },
  "styles": ["styles/base.css", "styles/theme.css"]
}
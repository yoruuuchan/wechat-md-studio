{
  "format": "reed-card-template",
  "formatVersion": 1,
  "id": "swiss-grid",
  "name": "Swiss Grid · 瑞士秩序",
  "version": "1.0.0",
  "author": "Reed · 改编自 geekfoxcharlie/XHS-TextCard（MIT）",
  "description": "改编自 geekfoxcharlie/XHS-TextCard 的 swiss-studio.json（MIT）。严格瑞士网格：超大粗标题压在左下，橙色模块占住右上网格，细体大号 01 当图形；正文左栏用大号章号配右栏阅读，结尾一条粗线收束。",
  "ratios": ["3:4", "1:1", "9:16"],
  "defaultRatio": "3:4",
  "variants": [
    { "id": "day", "name": "日光", "dark": false, "tokens": { "accent": "#E24A16", "text": "#171717", "muted": "#5B5B5B" } },
    { "id": "ink", "name": "墨夜", "dark": true, "tokens": { "accent": "#FF6A33", "text": "#F4F1E9", "muted": "#C8C5BD" } }
  ],
  "metrics": {
    "padX": 44,
    "padTop": 88,
    "padBottom": 66,
    "contentWidth": 452,
    "headerTop": 26,
    "footerBottom": 24,
    "coverInsetX": 46,
    "coverInsetY": 58,
    "coverFootBottom": 34,
    "coverReserve": 176,
    "coverTitleSize": [70, 64, 57, 50, 42],
    "coverSmallScale": 0.84
  },
  "fonts": [
    { "source": "builtin", "family": "Noto Sans SC", "weights": [400, 700] },
    { "source": "builtin", "family": "Geist", "weights": [400, 700] },
    { "source": "builtin", "family": "Geist Mono", "weights": [400] }
  ],
  "pages": { "cover": "pages/cover.html", "body": "pages/body.html", "end": "pages/end.html" },
  "styles": ["styles/base.css", "styles/theme.css"]
}
{
  "format": "reed-card-template",
  "formatVersion": 1,
  "id": "book-notes",
  "name": "Book Notes · 书页摘录",
  "version": "1.0.0",
  "author": "Reed · 改编自 geekfoxcharlie/XHS-TextCard（MIT）",
  "description": "改编自 geekfoxcharlie/XHS-TextCard 的 elegant-book.json（MIT）。书的扉页：布书脊、居中衬线标题和书签丝带；正文首行缩进两字、宽行距，引文作摘录；结尾把标题与作者收进一条长书签。",
  "ratios": ["3:4", "1:1", "9:16"],
  "defaultRatio": "3:4",
  "variants": [
    { "id": "cream", "name": "米纸", "dark": false, "tokens": { "accent": "#8C3A3A", "text": "#332A22", "muted": "#67584A" } },
    { "id": "night", "name": "夜读", "dark": true, "tokens": { "accent": "#D9A06A", "text": "#EFE3D3", "muted": "#C6B6A2" } }
  ],
  "metrics": {
    "padX": 50,
    "padTop": 96,
    "padBottom": 74,
    "contentWidth": 440,
    "headerTop": 30,
    "footerBottom": 28,
    "coverInsetX": 54,
    "coverInsetY": 74,
    "coverFootBottom": 42,
    "coverReserve": 196,
    "coverTitleSize": [68, 62, 55, 48, 42],
    "coverSmallScale": 0.84
  },
  "fonts": [
    { "source": "builtin", "family": "Noto Serif SC", "weights": [400, 700] },
    { "source": "builtin", "family": "Zhuque Fangsong", "weights": [400] }
  ],
  "customize": {
    "colors": [
      { "var": "--accent", "name": "主色" },
      { "var": "--title-ink", "name": "标题" },
      { "var": "--body-ink", "name": "正文" },
      { "var": "--muted", "name": "辅助文字" },
      { "var": "--paper", "name": "底色" }
    ],
    "fonts": [
      { "var": "--display", "name": "标题" },
      { "var": "--body-font", "name": "正文" }
    ]
  },
  "pages": { "cover": "pages/cover.html", "body": "pages/body.html", "end": "pages/end.html" },
  "styles": ["styles/base.css", "styles/theme.css"]
}